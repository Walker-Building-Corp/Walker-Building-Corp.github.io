{# Equipment teaser grid. Each card is fully clickable and deep-links to its
   anchor on the /equipment/ detail page. #}
<section class="section">
  <div class="container">
    <header class="section__header">
      <h2>{{ section.heading or "Our Equipment" }}</h2>
      {%- if section.intro %}<p class="section__intro">{{ section.intro }}</p>{% endif %}
    </header>
    <div class="card-grid">
      {%- for e in collections.equipment %}
        <article class="card">
          {%- if e.data.image %}
            <div class="card__image">
              <img
                src="{{ e.data.image }}"
                alt="{{ e.data.imageAlt or e.data.categoryTitle }}"
                width="{{ e.data.imageWidth }}"
                height="{{ e.data.imageHeight }}"
                loading="lazy"
                decoding="async"
              />
            </div>
          {%- endif %}
          <div class="card__body">
            <h3 class="card__title">
              <a class="card__cover-link" href="/equipment/#{{ e.fileSlug }}"
                >{{ e.data.categoryTitle }}</a
              >
            </h3>
            <p class="card__desc">{{ e.data.summary }}</p>
            <span class="card__link" aria-hidden="true">Learn more</span>
          </div>
        </article>
      {%- endfor %}
    </div>
  </div>
</section>
