{# Nav-menu data: parallels the WordPress menu config so we can render the
   active state for whichever page is currently being rendered. The menu-item
   and page-item IDs are baked into Elementor's CSS, so we preserve them. #}
{%
  set navItems = [
    { url: "/",          label: "Home",      menuItemId: 51, pageItemId: 31, isHome: true },
    { url: "/about/",    label: "About",     menuItemId: 50, pageItemId: 36 },
    { url: "/services/", label: "Services",  menuItemId: 49, pageItemId: 38 },
    { url: "/equipment/", label: "Equipment", menuItemId: 48, pageItemId: 40 },
    { url: "/careers/",  label: "Careers",   menuItemId: 47, pageItemId: 42 },
    { url: "/contact/",  label: "Contact",   menuItemId: 46, pageItemId: 44 }
  ]
%}
{# Build a li class string for a nav item, with conditional active markers.
   Uses string concatenation so Prettier can't strip the whitespace between tokens. #}
{% macro liClass(item, currentUrl) -%}
  {%- set classes = "menu-item menu-item-type-post_type menu-item-object-page" -%}
  {%- if item.isHome -%}{%- set classes = classes + " menu-item-home" -%}{%- endif -%}
  {%- if currentUrl == item.url -%}{%- set classes = classes + " current-menu-item page_item page-item-" + (item.pageItemId | string) + " current_page_item" -%}{%- endif -%}
  {%- set classes = classes + " menu-item-" + (item.menuItemId | string) -%}
  {{- classes -}}
{%- endmacro %}
{% macro aAttrs(item, currentUrl, mobile) -%}
  {%- set attrs = "" -%}
  {%- if currentUrl == item.url -%}{%- set attrs = attrs + ' aria-current="page"' -%}{%- endif -%}
  {%- if currentUrl == item.url -%}{%- set attrs = attrs + ' class="elementor-item elementor-item-active"' -%}{%- else -%}{%- set attrs = attrs + ' class="elementor-item"' -%}{%- endif -%}
  {%- if mobile -%}{%- set attrs = attrs + ' tabindex="-1"' -%}{%- endif -%}
  {{- attrs | safe -}}
{%- endmacro %}
