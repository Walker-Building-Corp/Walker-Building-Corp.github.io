<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <img src="/assets/img/logo.webp" alt="{{ site.name }} logo" width="100" height="100" />
        <p class="site-footer__tag">{{ site.tagline }}</p>
      </div>

      <nav aria-label="Services">
        <h2>Services</h2>
        <ul>
          <li><a href="/services/#bmp-management">BMP Management</a></li>
          <li><a href="/services/#street-sweeping">Street Sweeping</a></li>
          <li><a href="/services/#concrete-washouts">Concrete Washouts</a></li>
          <li><a href="/services/#debris-removal">Debris Removal</a></li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2>Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/equipment/">Equipment</a></li>
          <li><a href="/careers/">Careers</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>

      <div>
        <h2>Get in touch</h2>
        <ul>
          <li><a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>
            {{ site.address.street }}<br />
            {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}
          </li>
          <li>{{ site.hours.weekday }}</li>
        </ul>
      </div>
    </div>

    <div class="site-footer__base">&copy; {{ year }} {{ site.name }}. All rights reserved.</div>
  </div>
</footer>
