{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-jinja-template"],
  "overrides": [
    {
      "files": ["*.njk", "*.jinja", "*.jinja2"],
      "options": { "parser": "jinja-template" }
    },
    {
      "files": ["*.md"],
      "options": { "printWidth": 80, "proseWrap": "preserve" }
    }
  ]
}
